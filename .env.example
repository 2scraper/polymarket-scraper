# polymarket-scraper — copy to .env next to the scripts and fill in.
#
#   cp .env.example .env
#   python3 env_config.py        # prints what was picked up, WITHOUT secrets
#
# Credentials belong here and never on a command line: a secret in argv is
# readable by anything that can run `ps` and lands in shell history.
# `.env` is in .gitignore; keep it that way.
#
# Precedence, highest first:
#   an explicit flag  ->  an exported environment variable  ->  .env  ->  default
#
# Every value below is a PLACEHOLDER. Anything still carrying `{...}` braces
# is treated as unset, so a copied example is never sent to an API as if it
# were a key — the alternative is a 401 a long way from its cause.

# ---------------------------------------------------------------------------
# 2Captcha — one key, four separately billed products
# ---------------------------------------------------------------------------
# Captcha solving, the Scraping Browser API, proxies and fingerprints all sit
# behind this one key: https://2captcha.com
#
# Worth knowing before you buy any of it: on this site NONE of it is required
# to get data. Measured 2026-09-16 from one plain datacentre address in
# Finland, with no key, no proxy and no browser tricks:
#
#   twelve browser captures across four page kinds and three locales   all 200
#   `curl` announcing itself as `curl/8.0`                    200, 791,003 bytes
#   `curl` claiming HeadlessChrome/140                        200, 791,003 bytes
#   `curl` claiming python-requests/2.32                      200, 791,003 bytes
#
# Byte-identical to all three: this site does not read the client, and it did
# not rate-limit an ordinary run.
#
# What the key buys here is therefore VOLUME and GEOGRAPHY rather than
# access: many addresses instead of one, a specific exit country, a browser
# you do not have to install, and a consistent device identity. The captcha
# half of it is implemented and unexercised — no challenge was met while this
# repo was built, which is NOT the same as none being possible: the site sits
# behind Cloudflare, and a managed challenge there renders a Turnstile that
# 2Captcha solves with `TurnstileTaskProxyless`.
TWOCAPTCHA_KEY=your_2captcha_api_key_here

# ---------------------------------------------------------------------------
# The Scraping Browser API — a remote browser over CDP
# ---------------------------------------------------------------------------
#   country-{cc}   picks the exit country. Polymarket serves one catalogue
#                  from one host and localises by URL PATH (/es/predictions),
#                  so this is a rate and reachability lever rather than a
#                  content one.
#   pid-{id}       a profile with persistent cookies, ONE live connection
#                  each — reuse pids rather than minting one per run
#
# A profile's credentials live about a day, so the SHAPE is documented here
# and no working endpoint is ever pasted into this repo — a stale one would
# produce an auth error a long way from its cause.
#
# --concurrency is refused with --cdp-endpoint (workers would collide on the
# profile); use several pids, one run each.
#
# NOTE: selenium_scraper.py cannot use this. chromedriver's `debuggerAddress`
# takes a bare host:port with nowhere to put a password; Playwright and
# pyppeteer authenticate on the WebSocket upgrade and work fine.
POLYMARKET_CDP_ENDPOINT=ws://{login}-zone-scraping_browser-country-us-pid-{profileId}:{password}@cb.2captcha.com:9222

# ---------------------------------------------------------------------------
# A proxy exit
# ---------------------------------------------------------------------------
# Read as a single exit, or use --proxy-file for a pool.
#
# What a proxy is and is NOT for on this site:
#
#  * It is NOT needed to get in. A plain datacentre address with no proxy at
#    all was served every page tried — see the measurements above.
#
#  * It DOES spread the rate, which is what matters if you walk many
#    listings. `--mode events` fetches one listing plus its twenty event
#    pages, and running several categories at once from one address is the
#    way to find that site's limit rather than its data. `--delay` is the
#    cheaper lever; a pool is the one that scales.
#
# Note Selenium cannot authenticate a proxy at all (--proxy-server takes an
# address only). 2Captcha's IP-whitelist mode is the way around that.
POLYMARKET_PROXY=http://{user}:{password}@us.proxy.2captcha.com:2334

# ---------------------------------------------------------------------------
# A default URL, so a run needs no --url
# ---------------------------------------------------------------------------
# Any page this scraper reads:
#
#   a listing   https://polymarket.com/predictions
#               https://polymarket.com/predictions/crypto
#               https://polymarket.com/politics
#               https://polymarket.com/predictions?q=bitcoin
#   a locale    https://polymarket.com/es/predictions
#   an event    https://polymarket.com/event/fed-decision-in-september-762
#               https://polymarket.com/sports/laliga/lal-bar-rrc-2026-09-16
#
# A listing URL is ONE page of twenty events — the site publishes no address
# for the twenty-first — so `--pages` above 1 only fetches more in
# `--mode events`, which walks those twenty events' own pages. That is also
# the only mode where `--concurrency` has anything to do.
#
# Deliberately NOT here: an output prefix. `--out` already carries a
# non-empty default, so the loader would never see it as unset and the
# variable would be silently inert — a setting that looks configurable and is
# not.
POLYMARKET_URL=https://polymarket.com/predictions
